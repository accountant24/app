{
  "id": "quick-cash-entry",
  "tags": [
    "entry",
    "cash"
  ],
  "source": [
    "sessions"
  ],
  "why": "Quick entries in plain words are about a fifth of real use. The payee has to match the existing spelling (Farmers Market), dated today and paid from the wallet.",
  "fixture": "household",
  "turns": [
    {
      "text": "Spent $14.80 at the farmers market this morning, cash."
    }
  ],
  "expect": {
    "present": [
      {
        "date": "today",
        "payee": "^Farmers Market$",
        "postings": [
          {
            "account": "Assets:Cash:Wallet",
            "amount": -14.8,
            "commodity": "USD"
          },
          {
            "account": "Expenses:Food*",
            "amount": 14.8,
            "commodity": "USD"
          }
        ]
      }
    ],
    "countDelta": 1
  }
}
